<h1 class="sqd-page-title"><%= t("solid_queue_web.queues.title") %></h1>

<div class="sqd-card">
  <% if @queues.empty? %>
    <div class="sqd-empty"><%= t("solid_queue_web.queues.empty") %></div>
  <% else %>
    <table>
      <thead>
        <tr>
          <th scope="col"><%= t("solid_queue_web.queues.col_name") %></th>
          <th scope="col"><%= t("solid_queue_web.queues.col_size") %></th>
          <th scope="col"><%= t("solid_queue_web.queues.col_latency") %></th>
          <th scope="col"><%= t("solid_queue_web.queues.col_done_24h") %></th>
          <th scope="col"><%= t("solid_queue_web.queues.col_failed_24h") %></th>
          <th scope="col"><%= t("solid_queue_web.queues.col_failure_rate") %></th>
          <th scope="col"><%= t("solid_queue_web.queues.col_status") %></th>
          <th scope="col"><span class="sqd-sr-only"><%= t("solid_queue_web.queues.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% @queues.each do |queue| %>
          <tr>
            <td class="sqd-mono"><%= queue.name %></td>
            <td><%= @queue_sizes[queue.name] || 0 %></td>
            <td>
              <% if (oldest = @oldest_ready[queue.name]) %>
                <% age = Time.current - oldest %>
                <% latency_color = age > 86_400 ? "var(--danger)" : age > 3_600 ? "var(--warning)" : "inherit" %>
                <abbr title="<%= format_timestamp(oldest) %>">
                  <span style="color: <%= latency_color %>"><%= format_duration(age) %></span>
                </abbr>
              <% else %>
                <span style="color: var(--muted)">—</span>
              <% end %>
            </td>
            <td style="color: var(--success);"><%= @completed_24h[queue.name] || 0 %></td>
            <td style="color: <%= (@failed_24h[queue.name] || 0) > 0 ? "var(--danger)" : "inherit" %>;"><%= @failed_24h[queue.name] || 0 %></td>
            <td>
              <% sparkline = @failure_sparklines[queue.name] %>
              <% if sparkline.any? %>
                <div class="sqd-mini-sparkline" aria-label="<%= t("solid_queue_web.queues.failure_rate_aria", queue: queue.name) %>">
                  <% sparkline.each_with_index do |rate, i| %>
                    <% pct = rate || 0 %>
                    <% hour_label = (12 - i).hours.ago.strftime("%-I%p").downcase %>
                    <div class="sqd-mini-sparkline__bar sqd-mini-sparkline__bar--<%= rate ? "data" : "empty" %>"
                         style="height: <%= [pct, 2].max %>%"
                         title="<%= hour_label %>: <%= rate ? "#{rate}% failure rate" : "no data" %>"></div>
                  <% end %>
                </div>
              <% else %>
                <span style="color: var(--muted)">—</span>
              <% end %>
            </td>
            <td>
              <% if @paused_queue_names.include?(queue.name) %>
                <span class="sqd-badge sqd-badge--paused"><%= t("solid_queue_web.queues.status_paused") %></span>
              <% else %>
                <span class="sqd-badge sqd-badge--running"><%= t("solid_queue_web.queues.status_running") %></span>
              <% end %>
            </td>
            <td class="sqd-row-actions">
              <% if @paused_queue_names.include?(queue.name) %>
                <%= button_to t("solid_queue_web.queues.resume"), queue_pause_path(queue.name), method: :delete,
                      class: "sqd-btn sqd-btn--primary sqd-btn--sm" %>
              <% else %>
                <%= button_to t("solid_queue_web.queues.pause"), queue_pause_path(queue.name), method: :post,
                      class: "sqd-btn sqd-btn--muted sqd-btn--sm",
                      data: { confirm: t("solid_queue_web.queues.confirm_pause", name: queue.name) } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
